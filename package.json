{
  "name": "insurance-fraud-intelligence-poc",
  "version": "1.0.0",
  "description": "Insurance Fraud Intelligence and Investigation Proof of Concept",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "insurance",
    "fraud-detection",
    "investigation",
    "poc"
  ],
  "author": "",
  "license": "ISC"
}
